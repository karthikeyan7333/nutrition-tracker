NODE_ENV=development
PORT=5000
# Required: paste the MongoDB Atlas driver connection string for your database.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/nutrition_tracker?retryWrites=true&w=majority
# Optional only when a local DNS resolver refuses MongoDB Atlas SRV records.
# The backend automatically retries with public DNS for that specific error.
# Required: generate a unique long random value (for example: openssl rand -base64 48).
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Required for live Gemini nutrition lookups. If omitted, the original fallback nutrition behavior remains available.
GEMINI_API_KEY=your-gemini-api-key
# Preserves the legacy configured model; change only if your Gemini account requires a supported model name.
GEMINI_MODEL=gemini-3.5-flash
